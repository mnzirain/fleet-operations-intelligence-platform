FLEET_ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://fleet_app:change_me@localhost:5432/fleet_operations

# Required for vehicle and API-key-protected endpoints (minimum 16 characters).
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLEET_API_KEY=replace_with_a_long_random_value

# Required for webhook ingestion. The application can start without it,
# but POST /fleet-events/ returns HTTP 503 until configured.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Minimum 32 characters.
FLEET_WEBHOOK_SECRET=

# Webhook timestamp tolerance in seconds (default: 300; maximum: 3600).
FLEET_WEBHOOK_TOLERANCE_SECONDS=300
